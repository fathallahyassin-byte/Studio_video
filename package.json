    "db:seed": "prisma db seed",
    "auth:setup": "tsx scripts/auth-setup.ts",
    "postinstall": "prisma generate",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:e2e": "playwright test",
    "worker": "tsx jobs/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@next/env": "16.4.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
