# Copie ce fichier en .env.local. Les secrets restent dans .env.local, jamais dans le code.

# Adresse de l'appli (liens des notifications)
APP_URL="http://localhost:3000"

# Base de données (valeurs du docker-compose.yml)
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio"
# Facultatif : base migrée et seedée pour les tests d'intégration (npm run test)
# Avec `npx prisma dev` (Postgres embarqué, une seule connexion) : DATABASE_POOL_MAX="1"
DATABASE_POOL_MAX=""
TEST_DATABASE_URL=""
# Facultatif : base JETABLE pour npm run test:e2e (elle est vidée à chaque lancement)
E2E_DATABASE_URL=""

# Connexion (un seul compte) : remplis-les avec `npm run auth:setup`
AUTH_SECRET=""
OWNER_EMAIL=""
OWNER_PASSWORD_HASH=""
OWNER_TOTP_SECRET=""

# LLM : Claude (Anthropic). Le modèle se règle ensuite par agent dans l'interface.
LLM_PROVIDER="anthropic"
# Clé API Anthropic (ou rien si tu utilises `ant auth login` : le SDK lit le profil)
ANTHROPIC_API_KEY=""
# Modèle donné par le seed aux agents qui n'en ont pas encore
LLM_DEFAULT_MODEL="claude-opus-5-5"
# Profondeur de réflexion : low | medium | high | xhigh | max
LLM_EFFORT="high"
# Taux du dollar vers la monnaie des budgets (ex. 0.92 pour l'euro) ; 1 par défaut
USD_EXCHANGE_RATE="1"

# Médias
TTS_API_KEY=""
VIDEO_GEN_API_KEY=""
IMAGE_GEN_API_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Stockage S3 ou R2 : S3_ENDPOINT vide pour AWS (https://<compte>.r2.cloudflarestorage.com pour R2), région « auto » par défaut.
# S3_PUBLIC_BASE_URL = adresse publique du bucket (domaine R2 ou CloudFront), sans « / » final : les URL enregistrées en dépendent.
S3_REGION=""
S3_PUBLIC_BASE_URL=""

# Rendu Remotion sur le worker : images rendues en parallèle (vide = choix de Remotion) ; clé de licence si entreprise
RENDER_CONCURRENCY=""
REMOTION_LICENSE_KEY=""

# Worker (file de tâches dans PostgreSQL) : intervalle de scrutation en ms, facultatif
WORKER_POLL_MS="5000"

# Budgets
BUDGET_PAR_VIDEO="5"
BUDGET_MENSUEL="150"
BUDGET_SECONDES_VIDEO_IA="12"

# Notifications : telegram | email
NOTIFY_CHANNEL="telegram"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Publication
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""

# Suivi des erreurs
SENTRY_DSN=""
